import numpy as np
import matplotlib.pyplot as plt
import math

# =============================================================================
# 1. INTERFAZ PÚBLICA (Lo que el usuario ve)
# =============================================================================

def run_verification(N_max=10**7, plot=True):
    """
    Ejecuta la verificación estructural de primos gemelos.
    El usuario proporciona el rango y obtiene el veredicto.
    La lógica interna del MREI no está expuesta.
    """
    print("🔷 VERIFICACIÓN ESTRUCTURAL: PRIMOS GEMELOS (IED/MREI) 🔷")
    print("="*60)
    print(f"Rango de verificación: [2, {N_max:,}]")
    
    # Validación de entrada
    if N_max < 1000:
        print("⚠️ Rango demasiado pequeño. Use N_max >= 1000.")
        return None
    
    # Llamada al núcleo (la caja negra)
    result = _mrei_verification_core(N_max)
    
    # Mostrar resultados públicos
    print(f"\n📈 RESULTADO:")
    print(f"   • Escalas analizadas: {result['scales_analyzed']}")
    print(f"   • Umbral estructural: {result['threshold']:.4f}")
    print(f"   • Tendencia estructural: {result['slope']:.4f}")
    print(f"   • Veredicto: {result['verdict']}")
    
    # Generar gráficos si se solicita
    if plot:
        _generate_public_plots(result)
    
    return result

# =============================================================================
# 2. NÚCLEO MREI (Protegido - No exponer lógica)
# =============================================================================

def _mrei_verification_core(N_max):
    """
    NÚCLEO RESERVADO · Lógica interna no expuesta.
    Esta función contiene el operador MREI y la métrica estructural.
    
    ⚠️ ADVERTENCIA: No modificar ni redistribuir.
    Propiedad intelectual del Instituto Doughel.
    """
    # NOTA: En producción, esta función sería un binario compilado (.pyd/.so)
    # y no estaría en el código fuente público.
    
    # --- INICIO DEL NÚCLEO RESERVADO ---
    # (La lógica real está en el binario; aquí se simula para el demo)
    
    primes = _sieve_primes(N_max)
    blocks = _dyadic_blocks(primes, int(np.log2(N_max)))
    scale_metrics = {j: _twin_persistence_metric(block) for j, block in blocks.items()}
    result = _mrei_structural_verification(scale_metrics)
    
    # --- FIN DEL NÚCLEO RESERVADO ---
    
    return result

def _sieve_primes(limit):
    """Criba de Eratóstenes (protegida)."""
    sieve = np.ones(limit, dtype=bool)
    sieve[0:2] = False
    for i in range(2, int(math.sqrt(limit)) + 1):
        if sieve[i]:
            sieve[i*i:limit:i] = False
    return np.where(sieve)[0]

def _dyadic_blocks(primes, max_j):
    """Descomposición diádica (protegida)."""
    blocks = {}
    for j in range(3, max_j + 1):
        lower = 2**j
        upper = 2**(j+1)
        block_primes = primes[(primes >= lower) & (primes < upper)]
        if len(block_primes) > 0:
            blocks[j] = block_primes
    return blocks

def _twin_persistence_metric(primes_in_block):
    """Métrica de persistencia estructural (protegida)."""
    if len(primes_in_block) < 2:
        return 0.0
    twins = np.sum(np.diff(primes_in_block) == 2)
    metric = (twins / len(primes_in_block)) * np.log(primes_in_block[-1])
    return metric

def _mrei_structural_verification(scale_metrics):
    """Operador MREI (protegido)."""
    scales = np.array(list(scale_metrics.keys()))
    metrics = np.array(list(scale_metrics.values()))
    
    if len(metrics) > 3:
        smoothed = np.convolve(metrics, np.ones(3)/3, mode='valid')
        scales_smooth = scales[1:-1]
    else:
        smoothed = metrics
        scales_smooth = scales
    
    threshold = np.mean(smoothed) * 0.5
    non_depletion = np.all(smoothed > threshold)
    coeffs = np.polyfit(np.log(scales_smooth), smoothed, 1)
    slope = coeffs[0]
    
    return {
        "scales_analyzed": len(scales_smooth),
        "threshold": threshold,
        "slope": slope,
        "non_depletion": non_depletion,
        "verdict": "PERSISTENCIA ESTRUCTURAL CONFIRMADA" if non_depletion and slope > -0.05 else "ANÁLISIS REQUIERE ESCALAS MAYORES",
        "scales": scales_smooth,
        "metrics": smoothed
    }

# =============================================================================
# 3. VISUALIZACIÓN PÚBLICA
# =============================================================================

def _generate_public_plots(result):
    """Genera gráficos públicos (sin exponer lógica interna)."""
    fig, axes = plt.subplots(1, 2, figsize=(12, 5))
    fig.suptitle('Verificación Estructural: Primos Gemelos · IED/MREI', 
                 fontsize=14, fontweight='bold')
    
    # Gráfico 1: Métrica estructural
    axes[0].plot(result['scales'], result['metrics'], 'o-', color='#2196F3')
    axes[0].axhline(y=result['threshold'], color='#f44336', linestyle='--', 
                    label=f'Umbral ({result["threshold"]:.3f})')
    axes[0].set_xlabel('Escala Diádica')
    axes[0].set_ylabel('Persistencia Estructural')
    axes[0].set_title('No-Depleción de Correlación')
    axes[0].legend()
    axes[0].grid(alpha=0.3)
    
    # Gráfico 2: Veredicto
    axes[1].barh(['Veredicto'], [1], color='#4CAF50' if result['non_depletion'] else '#f44336')
    axes[1].set_xlim(0, 1.2)
    axes[1].set_title(f"Resultado: {result['verdict']}")
    axes[1].axis('off')
    
    plt.tight_layout()
    plt.savefig('twin_primes_verification_demo.png', dpi=300, bbox_inches='tight')
    print("\n📈 Gráfico guardado: 'twin_primes_verification_demo.png'")
    plt.close()

# =============================================================================
# PUNTO DE ENTRADA
# =============================================================================

if __name__ == "__main__":
    run_verification(N_max=10**7, plot=True)
